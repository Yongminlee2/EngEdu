<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card_paper"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnClose"
                style="@style/Widget.Piyak.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="레슨 닫기"
                android:src="@drawable/ic_close_rounded" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtLessonTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="오늘의 영어 모험"
                        android:textAppearance="@style/TextAppearance.Piyak.Caption"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/txtStep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="1 / 5"
                        android:textAppearance="@style/TextAppearance.Piyak.Caption"
                        android:textColor="@color/ink_muted" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progressBackgroundTint="@color/paper_alt"
                    android:progressDrawable="@drawable/progress_sticker"
                    android:progressTint="@color/mint_deep" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtHearts"
                style="@style/Widget.Piyak.StatPill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="남은 하트"
                android:drawableStart="@drawable/ic_favorite_rounded"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:minWidth="58dp"
                android:text="5"
                android:textColor="@color/coral_deep" />

            <Button
                android:id="@+id/btnHint"
                style="@style/Widget.Piyak.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:contentDescription="힌트 사용"
                android:drawableStart="@drawable/ic_lightbulb_rounded"
                android:drawablePadding="2dp"
                android:minWidth="58dp"
                android:text="0"
                android:textColor="@color/lavender_deep" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/questionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_question_surface"
                android:elevation="1dp"
                android:minHeight="300dp"
                android:padding="20dp" />
        </ScrollView>

        <Button
            android:id="@+id/btnCheck"
            style="@style/Widget.Piyak.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:text="확인" />
    </LinearLayout>

    <com.piyak.english.ui.ChickView
        android:id="@+id/chickView"
        android:layout_width="150dp"
        android:layout_height="58dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="18dp"
        android:importantForAccessibility="no" />

    <com.piyak.english.ui.CelebrateOverlayView
        android:id="@+id/celebrate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/feedbackPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_feedback_correct"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgFeedback"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="삐약이의 채점 결과"
                android:src="@drawable/chick_happy" />

            <TextView
                android:id="@+id/txtFeedback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="정답이에요!"
                android:textAppearance="@style/TextAppearance.Piyak.Section"
                android:textColor="@color/ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="11"
            android:scrollbars="vertical"
            android:textAppearance="@style/TextAppearance.Piyak.Body"
            android:textColor="@color/ink"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnContinue"
            style="@style/Widget.Piyak.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:drawableEnd="@drawable/ic_check_circle_rounded"
            android:text="계속하기" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgResult"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="삐약이"
            android:src="@drawable/chick_happy" />

        <TextView
            android:id="@+id/txtResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="레슨 완료!"
            android:textAppearance="@style/TextAppearance.Piyak.Title"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/txtResultStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_paper"
            android:gravity="center"
            android:padding="18dp"
            android:text=""
            android:textAppearance="@style/TextAppearance.Piyak.Body"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btnDone"
            style="@style/Widget.Piyak.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="모험 지도 돌아가기" />
    </LinearLayout>
</FrameLayout>
