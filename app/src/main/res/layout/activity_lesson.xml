<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 상단 바 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="12dp" android:paddingTop="0dp" android:paddingBottom="0dp">
            <ImageView android:id="@+id/btnClose"
                android:layout_width="34dp" android:layout_height="34dp" android:padding="6dp"
                android:src="@drawable/ui_close" android:contentDescription="그만두기"
                android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true"
                android:focusable="true" />
            <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1"
                android:layout_marginHorizontal="8dp" android:max="100"
                android:progressTint="@color/green_ok" android:progressBackgroundTint="@color/tile_border" />
            <TextView android:id="@+id/txtHearts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:text="5"
                android:drawableStart="@drawable/ic_heart" android:drawablePadding="6dp" android:drawableTint="@null" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHint" android:layout_width="wrap_content" android:layout_height="34dp"
                android:layout_marginStart="6dp" android:minWidth="0dp" android:minHeight="0dp"
                android:paddingHorizontal="14dp" android:insetTop="0dp" android:insetBottom="0dp"
                android:text="0" android:textSize="13sp"
                android:drawableStart="@drawable/ic_hint" android:drawablePadding="3dp"
                android:background="@drawable/bg_pill_lavender" android:backgroundTint="@null"
                android:textColor="@color/white" android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- 문제 영역 (타입별 뷰 교체) -->
        <ScrollView android:id="@+id/questionScroll"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true" android:scrollbars="vertical">
            <FrameLayout android:id="@+id/questionBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingHorizontal="16dp" android:paddingTop="0dp" android:paddingBottom="24dp" />
        </ScrollView>

        <!-- 확인 버튼 -->
        <Button android:id="@+id/btnCheck"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="16dp" android:text="@string/lesson_check" android:textSize="18sp"
            android:backgroundTint="@color/chick_yellow" android:textColor="@color/brown_text" />
    </LinearLayout>

    <!-- 상주 병아리 — 문제 영역 오른쪽 위에 떠 있다 (터치는 통과) -->
    <com.piyak.english.ui.ChickView android:id="@+id/chickView"
        android:layout_width="150dp" android:layout_height="58dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp" android:layout_marginEnd="10dp" />

    <!-- 정오답 피드백 패널 -->
    <LinearLayout android:id="@+id/feedbackPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:padding="20dp" android:visibility="gone"
        android:background="@drawable/bg_feedback_ok">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/imgFeedback" android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ck_idle" android:contentDescription="삐약이" />
            <TextView android:id="@+id/txtFeedback" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp"
                android:textSize="18sp" android:textStyle="bold" android:text="@string/praise_correct" />
        </LinearLayout>
        <TextView android:id="@+id/txtExplain" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="14sp" android:visibility="gone"
            android:maxLines="11" android:scrollbars="vertical" android:lineSpacingMultiplier="1.15" />
        <Button android:id="@+id/btnContinue"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/quit_no" android:textSize="17sp"
            android:backgroundTint="@color/green_ok" android:textColor="@color/white" />
    </LinearLayout>

    <!-- 결과 화면 -->
    <LinearLayout android:id="@+id/resultPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center"
        android:background="@color/cream" android:visibility="gone" android:padding="24dp">
        <ImageView android:id="@+id/imgResult" android:layout_width="150dp" android:layout_height="150dp"
            android:src="@drawable/ck_idle" android:contentDescription="삐약이" />
        <TextView android:id="@+id/txtResultTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="26sp" android:textStyle="bold" android:text="" />
        <TextView android:id="@+id/txtResultStats" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textSize="17sp" android:gravity="center" android:text="" />
        <Button android:id="@+id/btnDone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/done" android:textSize="18sp"
            android:backgroundTint="@color/chick_yellow" android:textColor="@color/brown_text" />
    </LinearLayout>
    <!-- 정답 색종이·콤보 오버레이 — 결과 화면 위에도 뿌려지도록 맨 마지막(최상단)에 둔다 -->
    <com.piyak.english.ui.CelebrateOverlayView android:id="@+id/celebrate"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
