<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Piyak.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="뒤로 가기"
            android:src="@drawable/ic_arrow_back_rounded" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="나의 성장 기록"
            android:textAppearance="@style/TextAppearance.Piyak.Title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_paper"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_chip_lavender"
                    android:contentDescription="레벨 별 스티커"
                    android:padding="15dp"
                    android:src="@drawable/ic_star_rounded" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtLevelBig"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="레벨 0"
                        android:textAppearance="@style/TextAppearance.Piyak.Title" />

                    <ProgressBar
                        android:id="@+id/xpBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressBackgroundTint="@color/paper_alt"
                        android:progressTint="@color/primary_deep" />

                    <TextView
                        android:id="@+id/txtXpDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Piyak.Caption" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtCounters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip_sky"
                android:lineSpacingExtra="5dp"
                android:padding="18dp"
                android:text="완료한 레슨  0개\n퍼펙트 레슨  0개\n복습 완료  0개\n공부한 날  0일"
                android:textAppearance="@style/TextAppearance.Piyak.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_paper"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_insights_rounded"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="영역별 실력"
                    android:textAppearance="@style/TextAppearance.Piyak.Section" />

                <TextView
                    android:id="@+id/txtRankLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip_mint"
                    android:padding="12dp"
                    android:textAppearance="@style/TextAppearance.Piyak.Body" />

                <LinearLayout
                    android:id="@+id/skillDetailBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_paper"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_local_fire_department_rounded"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="꾸준함 달력"
                    android:textAppearance="@style/TextAppearance.Piyak.Section" />

                <TextView
                    android:id="@+id/txtStreakInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Piyak.Caption" />

                <GridLayout
                    android:id="@+id/calGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="7" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_paper"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_trophy_rounded"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="모은 배지"
                    android:textAppearance="@style/TextAppearance.Piyak.Section" />

                <GridLayout
                    android:id="@+id/badgesGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="3" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
