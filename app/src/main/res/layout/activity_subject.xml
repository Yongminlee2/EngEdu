<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:gravity="center">

        <ImageView android:layout_width="120dp" android:layout_height="120dp"
            android:layout_marginTop="18dp"
            android:src="@drawable/chick_happy" android:contentDescription="삐약이" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="삐약공부"
            android:textSize="32sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtHello" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="오늘은 뭘 공부할까요?"
            android:textSize="15sp" android:textColor="@color/brown_soft" />

        <!-- 공유 스탯 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="16dp"
            android:padding="12dp" android:background="@drawable/bg_tile">
            <TextView android:id="@+id/txtCoins" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:textSize="15sp" android:text="💰 0원" />
            <TextView android:id="@+id/txtHearts" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:textSize="15sp" android:text="❤️ 5" />
            <TextView android:id="@+id/txtStreak" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:textSize="15sp" android:text="🔥 0" />
        </LinearLayout>

        <!-- 과목 카드 (코드 생성) -->
        <LinearLayout android:id="@+id/subjectsBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="14dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:gravity="center" android:textSize="12sp"
            android:textColor="@color/brown_soft"
            android:text="용돈 · 하트 · 스트릭은 두 과목이 함께 써요 🐥" />
    </LinearLayout>
</ScrollView>
