<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- 과목 전환 -->
        <Button android:id="@+id/btnSwitchSubject"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📘 영어  ▾" android:textSize="15sp"
            android:backgroundTint="@color/white" android:textColor="@color/brown_text" />

        <!-- 시간대별 풍경 배너 (codex 발주 #01) — 아침 하늘, 낮 풀밭, 저녁 교실, 밤하늘 -->
        <ImageView android:id="@+id/imgBanner"
            android:layout_width="match_parent" android:layout_height="96dp"
            android:layout_marginTop="8dp" android:scaleType="centerCrop"
            android:contentDescription="풍경" />

        <!-- 상단 스탯 바 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/txtHearts" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="16sp" android:text="❤️ 5" />
            <TextView android:id="@+id/txtStreak" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:textSize="16sp" android:text="🔥 0" />
            <TextView android:id="@+id/txtLevel" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:textSize="16sp" android:text="⭐ Lv.0" />
        </LinearLayout>

        <ProgressBar android:id="@+id/xpBar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="10dp"
            android:layout_marginTop="6dp" android:max="100"
            android:progressTint="@color/chick_yellow_deep" android:progressBackgroundTint="@color/cream_dark" />

        <!-- 마스코트 헤더 + 칭호 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="14dp">
            <ImageView android:id="@+id/imgMascot" android:layout_width="86dp" android:layout_height="86dp"
                android:src="@drawable/ck_idle" android:contentDescription="삐약이" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/txtRank" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🥚 알 속의 새싹" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtOverall" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="종합 실력 Lv.0" android:textSize="14sp" android:textColor="@color/brown_soft" />
                <ProgressBar android:id="@+id/rankBar" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:layout_marginTop="4dp" android:max="100"
                    android:progressTint="@color/chick_yellow_deep" android:progressBackgroundTint="@color/cream_dark" />
                <TextView android:id="@+id/txtGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="오늘도 삐약삐약 공부해요!" android:textSize="13sp" android:textColor="@color/brown_soft" />
            </LinearLayout>
        </LinearLayout>

        <!-- 오늘의 목표 -->
        <LinearLayout android:id="@+id/goalBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp"
            android:padding="14dp" android:background="@drawable/bg_tile">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/txtGoal" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="🎯 오늘의 목표  0 / 50 XP"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtGoalEdit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="변경" android:textSize="13sp" android:textColor="@color/sky_deep" />
            </LinearLayout>
            <ProgressBar android:id="@+id/goalBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:layout_marginTop="8dp" android:max="100"
                android:progressTint="@color/coral" android:progressBackgroundTint="@color/cream_dark" />
        </LinearLayout>

        <!-- 지갑 -->
        <LinearLayout android:id="@+id/cardWallet"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="12dp" android:padding="16dp"
            android:background="@drawable/bg_wallet">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💰" android:textSize="32sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/txtCoins" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0원" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="@color/brown_text" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="상점 · 현금으로 바꾸기" android:textSize="12sp"
                    android:textColor="@color/brown_soft" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🛒 ▶" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/brown_text" />
        </LinearLayout>

        <!-- 놀이터 (미니게임) -->
        <LinearLayout android:id="@+id/cardPlayground"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/bg_playground"
            android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎮" android:textSize="34sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="놀이터" android:textSize="19sp" android:textStyle="bold"
                    android:textColor="@color/brown_text" />
                <TextView android:id="@+id/txtPlayground"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="풍선 터뜨리기 · 담기 · 선 잇기" android:textSize="13sp"
                    android:textColor="@color/brown_soft" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="▶" android:textSize="18sp" android:textColor="@color/brown_text" />
        </LinearLayout>

        <!-- 알파벳 쓰기 연습 -->
        <LinearLayout android:id="@+id/cardAlphabet"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="12dp" android:padding="16dp"
            android:background="@drawable/bg_alphabet">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✏️" android:textSize="34sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="알파벳 쓰기 (ABC)" android:textSize="17sp" android:textStyle="bold"
                    android:textColor="@color/brown_text" />
                <TextView android:id="@+id/txtAlphabetSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="손가락·펜으로 A부터 Z까지 따라 써요" android:textSize="12sp"
                    android:textColor="@color/brown_soft" />
            </LinearLayout>
            <TextView android:id="@+id/txtAlphabetCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0/52" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/brown_text" />
        </LinearLayout>

        <!-- 내 실력 대시보드 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp"
            android:padding="14dp" android:background="@drawable/bg_tile">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="📊 내 실력" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtWeakest" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/brown_soft" />
            </LinearLayout>
            <LinearLayout android:id="@+id/skillsBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 레벨테스트 배너 -->
        <LinearLayout
            android:id="@+id/bannerPlacement"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:background="@drawable/bg_banner"
            android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            <TextView android:id="@+id/txtPlacement"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🎯 레벨테스트로 내 위치 찾기!\n25문제로 딱 맞는 레벨을 정해줘요"
                android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="GO ▶" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- 트랙 카드 컨테이너 (코드 생성) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="📚 학습 코스"
            android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/tracksBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="4dp" />

        <!-- 하단 버튼들 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/btnReview" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="💊 오답 0" android:textSize="14sp"
                android:minWidth="0dp" android:paddingHorizontal="4dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:background="@drawable/bg_card_soft" android:backgroundTint="@null"
                android:textColor="@color/brown_text" android:stateListAnimator="@null" />
            <Button android:id="@+id/btnStats" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="📊 통계" android:textSize="14sp"
                android:minWidth="0dp" android:paddingHorizontal="4dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:background="@drawable/bg_card_soft" android:backgroundTint="@null"
                android:textColor="@color/brown_text" android:stateListAnimator="@null" />
            <Button android:id="@+id/btnSettings" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="⚙️ 설정" android:textSize="14sp"
                android:minWidth="0dp" android:paddingHorizontal="4dp"
                android:insetTop="0dp" android:insetBottom="0dp"
                android:background="@drawable/bg_card_soft" android:backgroundTint="@null"
                android:textColor="@color/brown_text" android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
