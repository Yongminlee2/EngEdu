<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/txtKind" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp" android:textColor="@color/brown_soft" android:text="🔢 수학" />
        <Button android:id="@+id/btnSay" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔊 읽어주기" android:textSize="13sp"
            android:backgroundTint="@color/sky" android:textColor="@color/brown_text" />
    </LinearLayout>

    <TextView android:id="@+id/txtPrompt" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="22sp" android:textStyle="bold"
        android:lineSpacingMultiplier="1.25" />

    <com.piyak.english.ui.MathVisualView android:id="@+id/visual"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <!-- 그림을 손가락으로 짚어 셀 때 나오는 안내 -->
    <LinearLayout android:id="@+id/countBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:visibility="gone">
        <TextView android:id="@+id/txtCount" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="14sp" android:textColor="@color/brown_soft"
            android:text="👆 그림을 하나씩 짚어 세어 보세요" />
        <Button android:id="@+id/btnCountReset" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="0dp" android:paddingHorizontal="12dp"
            android:text="다시 세기" android:textSize="12sp"
            android:backgroundTint="@color/cream_dark" android:textColor="@color/brown_text" />
    </LinearLayout>

    <!-- 숫자 입력 -->
    <LinearLayout android:id="@+id/numberBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/txtAnswer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="14dp"
            android:background="@drawable/bg_tile" android:gravity="center"
            android:textSize="30sp" android:textStyle="bold" android:hint="?" />
        <com.piyak.english.ui.NumberPadView android:id="@+id/numberPad"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <!-- 4지선다 (2x2 큰 버튼) -->
    <GridLayout android:id="@+id/choicesGrid"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:columnCount="2" android:visibility="gone" />

    <!-- 식·문자 답 입력 -->
    <EditText android:id="@+id/editAnswer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:padding="14dp"
        android:background="@drawable/bg_tile" android:textSize="18sp"
        android:inputType="textNoSuggestions|textVisiblePassword" android:imeOptions="actionDone"
        android:hint="답을 입력하세요" android:importantForAutofill="no"
        android:visibility="gone" />
</LinearLayout>
