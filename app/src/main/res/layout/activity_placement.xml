<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClose"
                style="@style/Widget.Piyak.IconButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="레벨 찾기 닫기"
                android:drawableStart="@drawable/ic_close_rounded"
                android:drawableTint="@color/ink"
                android:text="" />

            <TextView
                android:id="@+id/txtScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:text="레벨 찾기"
                android:textAppearance="@style/TextAppearance.Piyak.Section" />

            <TextView
                android:id="@+id/txtCount"
                style="@style/Widget.Piyak.StatPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="1 / 25" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/space_3"
            android:max="100"
            android:progressDrawable="@drawable/progress_sticker" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_4"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/space_6">

            <LinearLayout
                android:id="@+id/questionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_question_surface"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_lavender"
                    android:text="나에게 맞는 시작점을 찾고 있어요"
                    android:textAppearance="@style/TextAppearance.Piyak.Caption"
                    android:textColor="@color/lavender_deep"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlay"
                    style="@style/Widget.Piyak.SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_4"
                    android:drawableStart="@drawable/ic_volume_up_rounded"
                    android:drawablePadding="@dimen/space_2"
                    android:drawableTint="@color/sky_deep"
                    android:text="문장 듣기"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:lineSpacingMultiplier="1.2"
                    android:textAppearance="@style/TextAppearance.Piyak.Title" />

                <LinearLayout
                    android:id="@+id/choicesBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone">

        <ImageView
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:contentDescription="탐험을 마친 삐약이"
            android:scaleType="centerInside"
            android:src="@drawable/chick_explorer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_card_paper"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_6">

            <TextView
                android:id="@+id/txtResultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Piyak.Title" />

            <TextView
                android:id="@+id/txtResultDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Piyak.Body" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDone"
            style="@style/Widget.Piyak.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_6"
            android:drawableEnd="@drawable/ic_flag_rounded"
            android:drawablePadding="@dimen/space_2"
            android:drawableTint="@color/ink"
            android:text="내 모험 시작하기" />
    </LinearLayout>
</FrameLayout>
