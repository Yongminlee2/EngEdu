<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/txtKind" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="10sp" app:autoSizeMaxTextSize="13sp"
            android:textSize="13sp" android:textColor="@color/brown_soft" android:text="" />
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ck_idle" android:contentDescription="삐약이" />
        <TextView android:id="@+id/txtCountInline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/brown_soft" android:text="1 / 12" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlay" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/btn_play" android:drawableStart="@drawable/ic_listen" android:drawablePadding="6dp" android:visibility="gone" android:textSize="16sp"
            android:paddingHorizontal="18dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:background="@drawable/bg_pill_sky" android:backgroundTint="@null"
            android:textColor="@color/brown_text" android:stateListAnimator="@null" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlaySlow" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="10dp" android:text="@string/btn_play_slow" android:drawableStart="@drawable/ic_slow" android:drawablePadding="6dp" android:visibility="gone" android:textSize="16sp"
            android:paddingHorizontal="18dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:background="@drawable/bg_pill_mint" android:backgroundTint="@null"
            android:textColor="@color/brown_text" android:stateListAnimator="@null" />
    </LinearLayout>

    <TextView android:id="@+id/txtPrompt" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="23sp" android:textStyle="bold"
        android:lineSpacingMultiplier="1.2" />

    <TextView android:id="@+id/txtHint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/brown_soft"
        android:visibility="gone" />

    <EditText android:id="@+id/editAnswer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:padding="14dp"
        android:background="@drawable/bg_tile" android:textSize="18sp"
        android:inputType="textNoSuggestions|textVisiblePassword" android:imeOptions="actionDone"
        android:hint="@string/ly_type_hint" android:importantForAutofill="no" />
</LinearLayout>
