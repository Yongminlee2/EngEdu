<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtKind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_lavender"
        android:drawableStart="@drawable/ic_edit_rounded"
        android:drawablePadding="5dp"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="받아쓰기"
        android:textAppearance="@style/TextAppearance.Piyak.Caption"
        android:textColor="@color/lavender_deep" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlay"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:drawableStart="@drawable/ic_volume_up_rounded"
            android:drawablePadding="6dp"
            android:text="듣기"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPlaySlow"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="0.8× 천천히"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.25"
        android:textAppearance="@style/TextAppearance.Piyak.Section"
        android:textColor="@color/ink" />

    <TextView
        android:id="@+id/txtHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Piyak.Caption"
        android:textColor="@color/ink_muted"
        android:visibility="gone" />

    <EditText
        android:id="@+id/editAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_choice"
        android:hint="영어로 입력하세요"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_muted"
        android:textSize="18sp" />
</LinearLayout>
