<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 상단: 나가기 · 점수 · 목숨 · 시간 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="12dp" android:paddingTop="8dp">
            <Button android:id="@+id/btnClose" style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✖" />
            <TextView android:id="@+id/txtScore" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:textSize="19sp" android:textStyle="bold" android:text="⭐ 0" />
            <TextView android:id="@+id/txtLives" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="17sp" android:text="❤️❤️❤️" />
        </LinearLayout>

        <ProgressBar android:id="@+id/timeBar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="10dp"
            android:layout_marginHorizontal="12dp" android:layout_marginTop="4dp" android:max="100"
            android:progressTint="@color/coral" android:progressBackgroundTint="@color/cream_dark" />

        <!-- 문제 -->
        <TextView android:id="@+id/txtQuestion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:padding="10dp"
            android:textSize="26sp" android:textStyle="bold" android:text="" />

        <!-- 게임판 (코드에서 갈아끼움) -->
        <FrameLayout android:id="@+id/gameBox"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <Button android:id="@+id/btnAction"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="12dp" android:text="@string/game_basket_done" android:textSize="17sp"
            android:visibility="gone"
            android:backgroundTint="@color/chick_yellow" android:textColor="@color/brown_text" />
    </LinearLayout>

    <!-- 결과 -->
    <LinearLayout android:id="@+id/resultPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center"
        android:background="@color/cream" android:visibility="gone" android:padding="24dp">
        <ImageView android:layout_width="140dp" android:layout_height="140dp"
            android:src="@drawable/ck_cheer" android:contentDescription="삐약이" />
        <TextView android:id="@+id/txtResultTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:textSize="28sp" android:textStyle="bold" android:text="" />
        <TextView android:id="@+id/txtResultBody" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:textSize="17sp" android:text="" />
        <Button android:id="@+id/btnAgain" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/ly_once_more" android:textSize="18sp"
            android:backgroundTint="@color/chick_yellow" android:textColor="@color/brown_text" />
        <Button android:id="@+id/btnQuit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/ly_stop" android:textSize="16sp"
            android:backgroundTint="@color/cream_dark" android:textColor="@color/brown_text" />
    </LinearLayout>
</FrameLayout>
