<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_4">

            <Button
                android:id="@+id/btnClose"
                style="@style/Widget.Piyak.IconButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="게임 닫기"
                android:drawableStart="@drawable/ic_close_rounded"
                android:drawableTint="@color/ink"
                android:text="" />

            <TextView
                android:id="@+id/txtScore"
                style="@style/Widget.Piyak.StatPill"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_star_rounded"
                android:drawablePadding="@dimen/space_1"
                android:drawableTint="@color/primary_deep"
                android:gravity="center"
                android:text="0" />

            <TextView
                android:id="@+id/txtLives"
                style="@style/Widget.Piyak.StatPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_2"
                android:drawableStart="@drawable/ic_favorite_rounded"
                android:drawablePadding="@dimen/space_1"
                android:drawableTint="@color/coral_deep"
                android:text="3" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/timeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginHorizontal="@dimen/space_4"
            android:layout_marginTop="@dimen/space_2"
            android:max="100"
            android:progressDrawable="@drawable/progress_sticker" />

        <TextView
            android:id="@+id/txtQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_4"
            android:background="@drawable/bg_question_surface"
            android:gravity="center"
            android:minHeight="76dp"
            android:padding="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.Piyak.Title" />

        <FrameLayout
            android:id="@+id/gameBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/space_3"
            android:layout_weight="1"
            android:background="@drawable/bg_card_paper"
            android:padding="@dimen/space_1" />

        <Button
            android:id="@+id/btnAction"
            style="@style/Widget.Piyak.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_margin="@dimen/space_4"
            android:text="다 담았어요"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:contentDescription="게임을 마친 탐험 병아리"
            android:scaleType="centerInside"
            android:src="@drawable/chick_explorer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_paper"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_6">

            <TextView
                android:id="@+id/txtResultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="끝!"
                android:textAppearance="@style/TextAppearance.Piyak.Title" />

            <TextView
                android:id="@+id/txtResultBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Piyak.Body" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAgain"
            style="@style/Widget.Piyak.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_6"
            android:drawableStart="@drawable/ic_replay_rounded"
            android:drawablePadding="@dimen/space_2"
            android:drawableTint="@color/ink"
            android:text="한 번 더" />

        <Button
            android:id="@+id/btnQuit"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_2"
            android:text="그만하기" />
    </LinearLayout>
</FrameLayout>
