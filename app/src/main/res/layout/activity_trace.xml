<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
            <Button android:id="@+id/btnClose" style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✖" />
            <TextView android:id="@+id/txtTitle" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="19sp" android:textStyle="bold" android:text="A" />
            <TextView android:id="@+id/txtStrokeInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/brown_soft" android:text="" />
        </LinearLayout>

        <!-- 단어 카드 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginHorizontal="12dp" android:padding="12dp"
            android:background="@drawable/bg_tile">
            <ImageView android:id="@+id/imgWordArt" android:layout_width="56dp" android:layout_height="56dp"
                android:visibility="gone" android:contentDescription="낱말 그림" />
            <TextView android:id="@+id/txtEmoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="40sp" android:text="🍎" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:id="@+id/txtWord" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="20sp" android:textStyle="bold" android:text="Apple" />
                <TextView android:id="@+id/txtWordKo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="@color/brown_soft" android:text="" />
            </LinearLayout>
            <Button android:id="@+id/btnSay" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔊" android:textSize="18sp"
                android:backgroundTint="@color/sky" android:textColor="@color/brown_text" />
        </LinearLayout>

        <!-- 쓰기 판 -->
        <com.piyak.english.ui.TraceView android:id="@+id/traceView"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_margin="10dp" android:background="@drawable/bg_tile" />

        <!--
          완성 문구("완성! 용돈 +10원 🎁 · '한 번 더 쓰기'로 연습해요!")는 두 줄이다.
          한 줄짜리 안내문 기준으로 자리를 잡아 두면 **아랫줄이 잘린다.**
          두 줄 자리를 못 박고, 더 긴 언어에서는 글자가 스스로 줄어들게 한다.
        -->
        <TextView android:id="@+id/txtHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/brown_soft"
            android:minLines="2" android:maxLines="2"
            android:paddingHorizontal="12dp" android:paddingBottom="2dp"
            android:textSize="15sp"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="11sp" app:autoSizeMaxTextSize="15sp"
            android:text="@string/ly_trace_hint" />

        <!--
          버튼 세 개는 **한 줄로 높이를 맞춘다.**
          글자 길이가 제각각이라 그냥 두면 "어떻게 써요?"·"한 번 더 쓰기"는 두 줄,
          "다음"만 한 줄이 되어 줄이 어긋난다. 한 줄로 고정하고, 안 들어가는 언어는
          글자가 스스로 줄어들게 한다.
        -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp" android:baselineAligned="false">
            <Button android:id="@+id/btnDemo" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="@string/ly_how"
                android:maxLines="1" android:paddingHorizontal="4dp" android:insetTop="0dp" android:insetBottom="0dp"
                app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9sp" app:autoSizeMaxTextSize="14sp"
                android:backgroundTint="@color/mint" android:textColor="@color/brown_text" />
            <Button android:id="@+id/btnAgain" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ly_clear2"
                android:maxLines="1" android:paddingHorizontal="4dp" android:insetTop="0dp" android:insetBottom="0dp"
                app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9sp" app:autoSizeMaxTextSize="14sp"
                android:backgroundTint="@color/cream_dark" android:textColor="@color/brown_text" />
            <Button android:id="@+id/btnNext" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ly_next"
                android:maxLines="1" android:paddingHorizontal="4dp" android:insetTop="0dp" android:insetBottom="0dp"
                app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9sp" app:autoSizeMaxTextSize="14sp"
                android:backgroundTint="@color/chick_yellow" android:textColor="@color/brown_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- 완성 축하 -->
    <LinearLayout android:id="@+id/donePanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center"
        android:visibility="gone" android:padding="24dp">
        <ImageView android:id="@+id/imgDoneBig" android:layout_width="120dp" android:layout_height="120dp"
            android:visibility="gone" android:contentDescription="낱말 그림" />
        <TextView android:id="@+id/txtDoneBig" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="64sp" android:text="🎉" />
        <TextView android:id="@+id/txtDoneMsg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="22sp" android:textStyle="bold" android:text="@string/ly_done_praise" />
    </LinearLayout>
</FrameLayout>
