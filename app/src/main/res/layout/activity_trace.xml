<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_4">

            <Button
                android:id="@+id/btnClose"
                style="@style/Widget.Piyak.IconButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="쓰기 연습 닫기"
                android:drawableStart="@drawable/ic_close_rounded"
                android:drawableTint="@color/ink"
                android:text="" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:text="A"
                android:textAppearance="@style/TextAppearance.Piyak.Section" />

            <TextView
                android:id="@+id/txtStrokeInfo"
                style="@style/Widget.Piyak.StatPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="1 / 3 획" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_4"
            android:background="@drawable/bg_card_paper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <TextView
                android:id="@+id/txtEmoji"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="A"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apple"
                    android:textAppearance="@style/TextAppearance.Piyak.Section" />

                <TextView
                    android:id="@+id/txtWordKo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사과"
                    android:textAppearance="@style/TextAppearance.Piyak.Caption" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSay"
                style="@style/Widget.Piyak.IconButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="단어 듣기"
                android:drawableStart="@drawable/ic_volume_up_rounded"
                android:drawableTint="@color/sky_deep"
                android:text="" />
        </LinearLayout>

        <com.piyak.english.ui.TraceView
            android:id="@+id/traceView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/space_4"
            android:layout_weight="1"
            android:background="@drawable/bg_question_surface" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_4"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="초록 1번부터 길을 따라 그려 보세요"
            android:textAppearance="@style/TextAppearance.Piyak.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <Button
                android:id="@+id/btnDemo"
                style="@style/Widget.Piyak.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="시범 보기"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAgain"
                style="@style/Widget.Piyak.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="지우기"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnNext"
                style="@style/Widget.Piyak.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:text="다음"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/donePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/space_6"
        android:background="@drawable/bg_card_paper"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtDoneBig"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_node_complete"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/ink"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/txtDoneMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:text="잘했어요!"
            android:textAppearance="@style/TextAppearance.Piyak.Section" />
    </LinearLayout>
</FrameLayout>
