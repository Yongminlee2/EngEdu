<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Piyak.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="홈으로 돌아가기"
            android:drawableStart="@drawable/ic_arrow_back_rounded"
            android:drawableTint="@color/ink"
            android:text="" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_draw_rounded"
            android:drawablePadding="@dimen/space_2"
            android:drawableTint="@color/lavender_deep"
            android:text="알파벳 쓰기"
            android:textAppearance="@style/TextAppearance.Piyak.Section" />

        <TextView
            android:id="@+id/txtDone"
            style="@style/Widget.Piyak.StatPill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:drawableStart="@drawable/ic_check_circle_rounded"
            android:drawablePadding="4dp"
            android:drawableTint="@color/mint_deep"
            android:text="0/52" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_card_paper"
        android:orientation="horizontal"
        android:padding="@dimen/space_2">

        <Button
            android:id="@+id/btnUpper"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="대문자 ABC" />

        <Button
            android:id="@+id/btnLower"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="소문자 abc" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:text="글자를 골라 손가락으로 따라 써 보세요"
        android:textAppearance="@style/TextAppearance.Piyak.Caption" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <GridLayout
            android:id="@+id/lettersGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:padding="@dimen/space_3"
            android:paddingBottom="@dimen/space_8" />
    </ScrollView>
</LinearLayout>
