<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <Button android:id="@+id/btnBack" style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◀" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ly_alpha_write" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtDone" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/brown_soft" android:text="0/52" />
    </LinearLayout>

    <!-- 대문자 / 소문자 전환 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="12dp">
        <Button android:id="@+id/btnUpper" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/ly_upper" android:textSize="16sp"
            android:backgroundTint="@color/chick_yellow" android:textColor="@color/brown_text"  android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9sp" app:autoSizeMaxTextSize="16sp" />
        <Button android:id="@+id/btnLower" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/ly_lower" android:textSize="16sp"
            android:backgroundTint="@color/cream_dark" android:textColor="@color/brown_text"  android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9sp" app:autoSizeMaxTextSize="16sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <GridLayout android:id="@+id/lettersGrid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="4" android:padding="10dp" android:paddingBottom="28dp" />
    </ScrollView>
</LinearLayout>
