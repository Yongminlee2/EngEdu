<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Piyak.IconButton"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="홈으로 돌아가기"
            android:drawableStart="@drawable/ic_arrow_back_rounded"
            android:drawableTint="@color/ink"
            android:text="" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_sports_esports_rounded"
            android:drawablePadding="@dimen/space_2"
            android:drawableTint="@color/coral_deep"
            android:text="놀이터"
            android:textAppearance="@style/TextAppearance.Piyak.Section" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginTop="@dimen/space_3"
        android:text="손가락으로 만지고 움직이며 익히는 짧은 게임이에요"
        android:textAppearance="@style/TextAppearance.Piyak.Caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_4"
        android:background="@drawable/bg_card_paper"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_2"
            android:text="난이도"
            android:textAppearance="@style/TextAppearance.Piyak.Stat" />

        <Button
            android:id="@+id/btnLv1"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="쉬움"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLv2"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:text="보통"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLv3"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:text="어려움"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/gamesBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_4"
            android:paddingBottom="@dimen/space_8" />
    </ScrollView>
</LinearLayout>
