<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/btnBack" style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◀" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ly_settings" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>


        <!-- 언어 고르기: 폰 언어와 상관없이 앱 언어를 바꿀 수 있어야 한다 -->
        <LinearLayout android:id="@+id/rowLanguage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
            android:background="?attr/selectableItemBackground" android:clickable="true"
            android:focusable="true">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ly_language" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtLanguage" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="@color/brown_soft" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="▶" android:textSize="15sp" android:textColor="@color/brown_soft" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/ly_tts_speed" android:textSize="16sp" android:textStyle="bold" />
        <SeekBar android:id="@+id/seekRate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:max="14" android:progress="7" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <TextView android:id="@+id/txtRate" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="1.0x" android:textColor="@color/brown_soft" />
            <Button android:id="@+id/btnTtsTest" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ly_tts_try" android:backgroundTint="@color/sky" android:textColor="@color/brown_text" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/ly_sfx" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/ly_sfx_note" android:textSize="12sp"
            android:textColor="@color/brown_soft" />
        <SeekBar android:id="@+id/seekSfx" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:max="100" android:progress="30" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/txtSfx" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="30%" android:textColor="@color/brown_soft" />
            <Button android:id="@+id/btnSfxTest" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ly_sfx_try" android:backgroundTint="@color/mint" android:textColor="@color/brown_text" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ly_free_move" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ly_track_free" android:textSize="13sp" android:textColor="@color/brown_soft" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchFree"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ly_heart_use" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ly_hearts_free" android:textSize="13sp"
                    android:textColor="@color/brown_soft" />
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchHearts"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <Button android:id="@+id/btnPlacement" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/ly_retest"
            android:backgroundTint="@color/lavender" android:textColor="@color/white" />

        <Button android:id="@+id/btnCrash" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/ly_errlog"
            android:backgroundTint="@color/cream_dark" android:textColor="@color/brown_text"
            android:visibility="gone" />

        <Button android:id="@+id/btnReset" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/ly_reset_all"
            android:backgroundTint="@color/coral_deep" android:textColor="@color/white" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center" android:textSize="13sp"
            android:textColor="@color/brown_soft"
            android:text="@string/ly_about" />
    </LinearLayout>
</ScrollView>
