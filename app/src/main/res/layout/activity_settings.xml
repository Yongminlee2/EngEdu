<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Piyak.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="뒤로 가기"
            android:src="@drawable/ic_arrow_back_rounded" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="학습 설정"
            android:textAppearance="@style/TextAppearance.Piyak.Title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_sky"
                android:drawableStart="@drawable/ic_settings_rounded"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="나에게 꼭 맞는 학습 환경을 골라요"
                android:textAppearance="@style/TextAppearance.Piyak.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_paper"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_volume_up_rounded"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="소리와 발음"
                    android:textAppearance="@style/TextAppearance.Piyak.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="영어 발음 속도"
                    android:textAppearance="@style/TextAppearance.Piyak.Body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="듣기와 대화 문제를 읽어 주는 속도예요"
                    android:textAppearance="@style/TextAppearance.Piyak.Caption" />

                <SeekBar
                    android:id="@+id/seekRate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:max="14"
                    android:progress="7"
                    android:progressTint="@color/primary_deep"
                    android:thumbTint="@color/primary_deep" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtRate"
                        style="@style/Widget.Piyak.StatPill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="1.0x" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnTtsTest"
                        style="@style/Widget.Piyak.SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:drawableStart="@drawable/ic_volume_up_rounded"
                        android:drawablePadding="8dp"
                        android:text="발음 들어보기" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="효과음 크기"
                    android:textAppearance="@style/TextAppearance.Piyak.Body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="정답과 보상 효과음의 크기를 조절해요"
                    android:textAppearance="@style/TextAppearance.Piyak.Caption" />

                <SeekBar
                    android:id="@+id/seekSfx"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="30"
                    android:progressTint="@color/mint_deep"
                    android:thumbTint="@color/mint_deep" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtSfx"
                        style="@style/Widget.Piyak.StatPill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="30%" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnSfxTest"
                        style="@style/Widget.Piyak.SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="효과음 들어보기" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_paper"
                android:gravity="center_vertical"
                android:minHeight="88dp"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="자유 이동 모드"
                        android:textAppearance="@style/TextAppearance.Piyak.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="모든 레슨을 순서와 관계없이 열어요"
                        android:textAppearance="@style/TextAppearance.Piyak.Caption" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFree"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="자유 이동 모드" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_paper"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="학습 데이터"
                    android:textAppearance="@style/TextAppearance.Piyak.Section" />

                <Button
                    android:id="@+id/btnPlacement"
                    style="@style/Widget.Piyak.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_bar_chart_rounded"
                    android:drawablePadding="10dp"
                    android:text="영어 레벨테스트 다시 보기" />

                <Button
                    android:id="@+id/btnCrash"
                    style="@style/Widget.Piyak.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:text="마지막 오류 기록 보기"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/Widget.Piyak.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip_coral"
                    android:text="진행도 전체 초기화"
                    android:textColor="@color/coral_deep" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="삐약영어는 영어 공부를 재미있는 작은 모험으로 만들어요.\n말하기 채점은 기기와 주변 소리에 따라 달라질 수 있어요."
                android:textAppearance="@style/TextAppearance.Piyak.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
