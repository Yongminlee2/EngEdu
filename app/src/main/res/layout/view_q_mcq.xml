<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/txtKind" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="13sp" android:textColor="@color/brown_soft" android:text="🔤 뜻 고르기" />
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ck_idle" android:contentDescription="삐약이" />
        <TextView android:id="@+id/txtCountInline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/brown_soft" android:text="1 / 12" />
    </LinearLayout>

    <!-- 지문이 길면 지문 안에서 스크롤한다 — 안 그러면 선택지가 화면 밖으로 밀린다 -->
    <TextView android:id="@+id/txtPassage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:padding="14dp" android:background="@drawable/bg_tile_ghost"
        android:textSize="15sp" android:lineSpacingMultiplier="1.25" android:visibility="gone"
        android:maxHeight="200dp" android:scrollbars="vertical" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlay" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="듣기" android:drawableStart="@drawable/ic_listen" android:drawablePadding="6dp" android:visibility="gone" android:textSize="16sp"
            android:paddingHorizontal="22dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:background="@drawable/bg_pill_sky" android:backgroundTint="@null"
            android:textColor="@color/brown_text" android:stateListAnimator="@null" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlaySlow" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="10dp" android:text="천천히" android:drawableStart="@drawable/ic_slow" android:drawablePadding="6dp" android:visibility="gone" android:textSize="16sp"
            android:paddingHorizontal="22dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:background="@drawable/bg_pill_mint" android:backgroundTint="@null"
            android:textColor="@color/brown_text" android:stateListAnimator="@null" />
    </LinearLayout>

    <TextView android:id="@+id/txtBigEmoji" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center"
        android:textSize="76sp" android:visibility="gone" />

    <TextView android:id="@+id/txtPrompt" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="23sp" android:textStyle="bold"
        android:lineSpacingMultiplier="1.2" />

    <LinearLayout android:id="@+id/choicesBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="14dp" />
</LinearLayout>
