<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtKind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_sky"
        android:drawableStart="@drawable/ic_star_rounded"
        android:drawablePadding="5dp"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="뜻 고르기"
        android:textAppearance="@style/TextAppearance.Piyak.Caption"
        android:textColor="@color/sky_deep" />

    <TextView
        android:id="@+id/txtPassage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_paper"
        android:lineSpacingMultiplier="1.3"
        android:padding="16dp"
        android:textAppearance="@style/TextAppearance.Piyak.Body"
        android:textColor="@color/ink"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlay"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:drawableStart="@drawable/ic_volume_up_rounded"
            android:drawablePadding="6dp"
            android:text="듣기"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPlaySlow"
            style="@style/Widget.Piyak.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="0.8× 천천히"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtBigEmoji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="76sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.25"
        android:textAppearance="@style/TextAppearance.Piyak.Section"
        android:textColor="@color/ink" />

    <LinearLayout
        android:id="@+id/choicesBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />
</LinearLayout>
