<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/txtKind" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end"
            android:textSize="13sp" android:textColor="@color/brown_soft" android:text="🔤 뜻 고르기" />
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ck_idle" android:contentDescription="삐약이" />
        <TextView android:id="@+id/txtCountInline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/brown_soft" android:text="1 / 12" />
    </LinearLayout>

    <TextView android:id="@+id/txtPrompt" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="23sp" android:textStyle="bold"
        android:lineSpacingMultiplier="1.2" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="내 답:" android:textSize="13sp" android:textColor="@color/brown_soft" />

    <com.piyak.english.ui.FlowLayout android:id="@+id/answerFlow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="76dp" android:padding="10dp"
        android:background="@drawable/bg_tile_ghost" />

    <com.piyak.english.ui.FlowLayout android:id="@+id/bankFlow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:padding="8dp" />
</LinearLayout>
