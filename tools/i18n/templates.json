{
 "c8b5801d": {
  "ko": "들린 단어의 뜻은?",
  "args": 0,
  "n": 2
 },
 "366dec85": {
  "ko": "들린 문장의 뜻은?",
  "args": 0,
  "n": 1
 },
 "a933e669": {
  "ko": "\"%1$s\" 의 뜻은?",
  "args": 1,
  "n": 2
 },
 "55f8727e": {
  "ko": "삐약이가 \"%1$s!\" 하고 외쳤어요. 무슨 뜻일까요?",
  "args": 1,
  "n": 1
 },
 "452676ab": {
  "ko": "칠판에 \"%1$s\" 라고 적혀 있어요. 뜻을 골라 보세요!",
  "args": 1,
  "n": 1
 },
 "01751329": {
  "ko": "토끼가 물었어요. \"%1$s 가 무슨 뜻이야?\"",
  "args": 1,
  "n": 1
 },
 "98393c1b": {
  "ko": "그림책에서 \"%1$s\" 를 봤어요. 무슨 뜻일까요?",
  "args": 1,
  "n": 1
 },
 "f3b29e08": {
  "ko": "오늘의 단어는 \"%1$s\"! 뜻을 맞혀 볼까요?",
  "args": 1,
  "n": 1
 },
 "375f518e": {
  "ko": "\"%1$s\" 는 어떤 그림일까요?",
  "args": 1,
  "n": 1
 },
 "ad76c0d4": {
  "ko": "\"%1$s\" 를 그림에서 찾아 보세요!",
  "args": 1,
  "n": 1
 },
 "6dc70e58": {
  "ko": "삐약이가 \"%1$s\" 를 찾고 있어요. 어떤 그림일까요?",
  "args": 1,
  "n": 1
 },
 "a0168b2f": {
  "ko": "\"%1$s\" 에 어울리는 그림을 골라 보세요.",
  "args": 1,
  "n": 1
 },
 "b797909f": {
  "ko": "\"%1$s\" 를 영어로?",
  "args": 1,
  "n": 1
 },
 "21a6d4b2": {
  "ko": "삐약이에게 \"%1$s\" 를 영어로 알려 주세요!",
  "args": 1,
  "n": 1
 },
 "4002700b": {
  "ko": "펭귄이 궁금해해요. \"%1$s\" 는 영어로?",
  "args": 1,
  "n": 1
 },
 "b5f5d7a9": {
  "ko": "영어 시간! \"%1$s\" 를 영어로 골라 보세요.",
  "args": 1,
  "n": 1
 },
 "b2ecaffb": {
  "ko": "엄마가 물었어요. \"%1$s 가 영어로 뭐야?\"",
  "args": 1,
  "n": 1
 },
 "018ef4e1": {
  "ko": "대화 중 \"%1$s...\" 문장의 뜻은?",
